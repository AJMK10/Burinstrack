# =============================================================
# BurinTrack — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer .env dans git
# =============================================================

# Base de données Supabase (PostgreSQL géré)
SUPABASE_DB_PASSWORD=changeme_supabase_db_password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT — Générer avec: openssl rand -base64 64
JWT_SECRET=changeme_generate_with_openssl_rand_base64_64

# URL de l'application
APP_URL=https://burintrack.burinfort.com

# Email SMTP
EMAIL_FROM=noreply@burinfort.com
SMTP_HOST=smtp.burinfort.com
SMTP_PORT=587
SMTP_USER=noreply@burinfort.com
SMTP_PASSWORD=changeme

# MinIO (stockage fichiers)
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme_minio_password

# Redis — Générer avec: openssl rand -hex 32
REDIS_PASSWORD=changeme_generate_with_openssl_rand_hex_32

# Admin initial — utilisé UNIQUEMENT au 1er démarrage si aucun utilisateur n'existe
# Doit respecter: 12 caractères min, majuscule, minuscule, chiffre, caractère spécial
# Exemple: openssl rand -base64 12 | tr -d '=' | head -c 12
ADMIN_INITIAL_PASSWORD=changeme_strong_password_12chars_min
