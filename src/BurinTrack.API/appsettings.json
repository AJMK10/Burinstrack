{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=burintrack;Username=burintrack;Password=burintrack_dev",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "burintrack-api",
    "Audience": "burintrack-web"
  },
  "Email": {
    "De": "noreply@burinfort.com",
    "Smtp": "${SMTP_HOST}",
    "Port": "587",
    "Utilisateur": "${SMTP_USER}",
    "MotDePasse": "${SMTP_PASSWORD}"
  },
  "RateLimit": {
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/auth/login",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "MinIO": {
    "Endpoint": "localstack:4566",
    "AccessKey": "${MINIO_USER}",
    "SecretKey": "${MINIO_PASSWORD}",
    "BucketName": "burintrack",
    "Secure": false
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
